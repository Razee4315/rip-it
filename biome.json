{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off",
				"noImplicitAnyLet": "error",
				"noAssignInExpressions": "off"
			},
			"correctness": {
				"noUnusedVariables": "warn",
				"noUnusedImports": "warn",
				"useExhaustiveDependencies": "off"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useTemplate": "warn",
				"useSingleVarDeclarator": "off",
				"noParameterAssign": "off"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": "off",
				"noForEach": "off",
				"noUselessSwitchCase": "off"
			},
			"a11y": {
				"useSemanticElements": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"jsxQuoteStyle": "double",
			"trailingCommas": "all",
			"semicolons": "always",
			"arrowParentheses": "always",
			"bracketSpacing": true
		}
	},
	"files": {
		"include": ["src/**/*.ts", "src/**/*.tsx"],
		"ignore": [
			"node_modules/**",
			"dist/**",
			"src-tauri/target/**",
			"src-tauri/gen/**",
			"*.config.ts",
			"*.config.js",
			"src/sim/ClothEngine.ts"
		]
	}
}
